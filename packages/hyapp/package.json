{
  "name": "@hyos/hyapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./compiler": {
      "types": "./dist/src/compiler.d.ts",
      "import": "./dist/src/compiler.js"
    },
    "./esbuild": {
      "types": "./dist/src/esbuild.d.ts",
      "import": "./dist/src/esbuild.js"
    },
    "./http": {
      "types": "./dist/src/http.d.ts",
      "import": "./dist/src/http.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "import": "./dist/src/node/index.js"
    },
    "./solid": {
      "types": "./dist/src/solid.d.ts",
      "import": "./dist/src/solid.js"
    },
    "./wire": {
      "types": "./dist/src/wire.d.ts",
      "import": "./dist/src/wire.js"
    }
  },
  "scripts": {
    "build": "npm run build:hydb && tsc",
    "build:hydb": "npm run build --workspace @hyos/hydb",
    "test": "npm run build:hydb && tsc --noEmit && tsc && node --conditions=browser --test dist/test/*.test.js",
    "typecheck": "npm run build:hydb && tsc --noEmit"
  },
  "dependencies": {
    "@hyos/hydb": "0.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  }
}
