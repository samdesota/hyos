{
  "name": "@hyos/hyagent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail npm:dev:server npm:dev:client",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hyos/hydb": "0.0.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "solid-js": "^1.9.15",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
