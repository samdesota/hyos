    "typecheck": "tsc --noEmit && tsc --noEmit -p sandbox-prototype/tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "html2canvas": "^1.4.1",
    "magic-string": "^1.2.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
