{
  "name": "@hyos/ui-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./trpc": {
      "types": "./dist/src/trpc.d.ts",
      "import": "./dist/src/trpc.js"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "import": "./dist/src/vite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "sandbox": "vite sandbox-prototype --host 127.0.0.1",
