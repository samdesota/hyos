{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "application.manifest.ts",
    "manifest-contract.ts",
    "capabilities/**/*.ts",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "*.d.ts"
  ]
}
