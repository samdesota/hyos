{
  "name": "hyos",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "demo:project-management": "npm run dev --workspace @hyos/hydb-project-management-example",
    "dev": "npm run dev --workspace @hyos/components",
    "build": "npm run build --workspace @hyos/components",
    "typecheck": "npm run typecheck --workspace @hyos/components",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,js,jsx,json,md,ts,tsx,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2"
  }
}
